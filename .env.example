# Gemini API Multi-Account Gateway Configuration Example

# Gemini Model (e.g., gemini-2.5-flash or gemini-1.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Option 1: Comma-separated list of Gemini API Keys
GEMINI_API_KEYS=AIzaSyA_ExampleKey1...,AIzaSyB_ExampleKey2...,AIzaSyC_ExampleKey3...

# Option 2: Individual Gemini API Key definitions for 10+ accounts
GEMINI_API_KEY_1=AIzaSyA_ExampleKey1...
GEMINI_API_KEY_2=AIzaSyB_ExampleKey2...
GEMINI_API_KEY_3=AIzaSyC_ExampleKey3...
GEMINI_API_KEY_4=AIzaSyD_ExampleKey4...
GEMINI_API_KEY_5=AIzaSyE_ExampleKey5...
GEMINI_API_KEY_6=AIzaSyF_ExampleKey6...
GEMINI_API_KEY_7=AIzaSyG_ExampleKey7...
GEMINI_API_KEY_8=AIzaSyH_ExampleKey8...
GEMINI_API_KEY_9=AIzaSyI_ExampleKey9...
GEMINI_API_KEY_10=AIzaSyJ_ExampleKey10...

# Gateway Tuning Parameters
MAX_RETRIES=3
CONCURRENCY_LIMIT=5
CACHE_TTL_SECONDS=86400
ENABLE_CACHE=true
BASE_COOLDOWN_SECONDS=60
DATABASE_URL=sqlite+aiosqlite:///gateway.db
